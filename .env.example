# Configuracao do CNPJ-full.
# Copie para ".env" na RAIZ do projeto (ao lado deste arquivo):
#   Linux/macOS/Docker:  cp .env.example .env
#   Windows (cmd):       copy .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
# O .env nao vai para o git. Variaveis definidas no ambiente (ex.: docker run -e)
# tem prioridade sobre o .env. Detalhes em docs/ambientes.md.

# --- Banco SQLite ------------------------------------------------------------
# Tipo de banco. Por enquanto as consultas usam apenas sqlite.
CNPJ_DB_TIPO=sqlite

# Arquivo SQLite usado pelo consulta.py quando --base nao e informado.
# Caminho relativo a RAIZ do projeto (nao a pasta onde voce roda o comando) ou absoluto.
# Padrao: o banco de teste versionado, com dados ficticios.
CNPJ_DB_ARQUIVO=dados_teste/cnpj_teste.db
# Banco de exemplo do cnpjrfb (dados reais, 10 mil empresas, grafo com poucos vinculos):
#CNPJ_DB_ARQUIVO=dados_teste/cnpjrfb.db
# Base completa gerada pelo cnpj.py (ex.: python cnpj_full/cnpj.py dados sqlite saida --dir):
#CNPJ_DB_ARQUIVO=saida/CNPJ_full.db
# Caminho absoluto no Linux / dentro do Docker:
#CNPJ_DB_ARQUIVO=/dados/cnpj/CNPJ_full.db
# Caminho absoluto no Windows: use barras normais (/) ou aspas simples.
#CNPJ_DB_ARQUIVO=D:/dados/cnpj/CNPJ_full.db
#CNPJ_DB_ARQUIVO='D:\dados\cnpj\CNPJ_full.db'

# --- Consultas ---------------------------------------------------------------
# Navegador aberto automaticamente com o grafo.html (--viz). Vazio: nao abre.
#CNPJ_NAVEGADOR=C:/Program Files/Google/Chrome/Application/chrome.exe

# --- Docker (docker-compose.yml) --------------------------------------------
# No Linux, use o seu usuario para os arquivos gerados no volume nao ficarem do root.
# Valores: saida de "id -u" e "id -g". No Windows (Docker Desktop) deixe comentado.
#CNPJ_UID=1000
#CNPJ_GID=1000

# --- Scripts extra_csv (separar estabelecimento.csv por UF ou municipio) -----
# Pasta do estabelecimento.csv gerado pela carga csv, TERMINANDO com "/".
# Relativa a pasta onde voce roda o script.
#FILES_LOCATION=saida/
