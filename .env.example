# Copie este arquivo para .env (na raiz do projeto) e ajuste.
# Variaveis ja definidas no ambiente (docker-compose, export, set) tem prioridade.

# ---------------------------------------------------------------------------
# Download dos arquivos da Receita (cnpj_full/download.py, docs/download.md)
# ---------------------------------------------------------------------------
# URL do compartilhamento da RF
CNPJ_RF_URL=https://arquivos.receitafederal.gov.br/index.php/s/YggdBLfdninEJX9
# Pasta onde salvar os ZIPs (vao para <pasta>/<AAAA-MM>/)
CNPJ_PASTA_DOWNLOAD=dados

# ---------------------------------------------------------------------------
# PostgreSQL (cnpj.py <entrada> postgres --dir, docs/postgresql.md)
# ---------------------------------------------------------------------------
CNPJ_DB_HOST=localhost
CNPJ_DB_PORTA=5432
CNPJ_DB_NOME=dados_rfb
CNPJ_DB_USUARIO=postgres
CNPJ_DB_SENHA=
CNPJ_DB_SCHEMA=dados_rfb

# ---------------------------------------------------------------------------
# Separacao do estabelecimento.csv por UF/municipio (extra_csv)
# Pasta do estabelecimento.csv, terminando com /
# ---------------------------------------------------------------------------
FILES_LOCATION=/media/Arquivos/
