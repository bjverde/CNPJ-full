# Configuracao do CNPJ-full.
# Copie para ".env" na RAIZ do projeto (ao lado deste arquivo):
#   Linux/macOS/Docker:  cp .env.example .env
#   Windows (cmd):       copy .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
# Sem .env tudo funciona com os padroes (consultas no banco de teste).
#
# - O .env nao vai para o git.
# - Variaveis definidas no ambiente (ex.: docker run -e, set, export) tem
#   prioridade sobre o .env.
# - Caminhos relativos neste arquivo partem da RAIZ do projeto, nao da pasta
#   onde voce roda o comando.
# - Para usar um .env em outro lugar, defina CNPJ_ENV=<caminho> no ambiente.
# Detalhes em docs/ambientes.md (secao "Arquivo .env").

# =============================================================================
# CONSULTAS E GRAFO (cnpj_full/consulta.py)
# As consultas usam SQLite. Esta linha vale junto com qualquer bloco de carga
# abaixo (ex.: carga no PostgreSQL e consultas na base SQLite).
# =============================================================================
# Arquivo SQLite usado quando --base nao e informado.
# Padrao: o banco de teste versionado, com dados ficticios.
CNPJ_DB_ARQUIVO=dados/teste/cnpj_teste.db
# Base completa gerada pelo carga.py (python cnpj_full/carga.py dados/2026-10 sqlite saida --dir):
#CNPJ_DB_ARQUIVO=saida/CNPJ_full.db
# Caminho absoluto no Linux / dentro do Docker:
#CNPJ_DB_ARQUIVO=/dados/cnpj/CNPJ_full.db
# Caminho absoluto no Windows: use barras normais (/) ou aspas simples.
#CNPJ_DB_ARQUIVO=D:/dados/cnpj/CNPJ_full.db
#CNPJ_DB_ARQUIVO='D:\dados\cnpj\CNPJ_full.db'

# =============================================================================
# CARGA EM SGBD (cnpj_full/carga.py <zips> <sgbd> --dir)
# O SGBD da carga vai na linha de comando (sqlite, csv ou postgres); estas
# variaveis sao a conexao. Deixe sem # apenas UM dos blocos abaixo.
#
#   postgres   carga                                     - pronto
#   mysql      MySQL/MariaDB                             - planejado
#   sqlserver  SQL Server                                - planejado
#   oracle     Oracle                                    - planejado
# Os blocos dos bancos planejados ja mostram os nomes que serao usados.
# CNPJ_DB_TIPO ainda nao e lido pelo programa: esta nos blocos para quando as
# consultas tambem funcionarem nesses bancos.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
# Carga: python cnpj_full/carga.py dados/2026-10 postgres --dir   (docs/postgresql.md)
# O banco e o schema sao criados se nao existirem.
# No Docker, use em CNPJ_DB_HOST o nome do servico/container do PostgreSQL (nao localhost).
#CNPJ_DB_TIPO=postgres
#CNPJ_DB_HOST=localhost
#CNPJ_DB_PORTA=5432
#CNPJ_DB_NOME=dados_rfb
#CNPJ_DB_USUARIO=postgres
#CNPJ_DB_SENHA=troque_esta_senha
#CNPJ_DB_SCHEMA=dados_rfb

# --- MySQL / MariaDB (planejado) ---------------------------------------------
# No MySQL, schema e banco sao a mesma coisa: use so CNPJ_DB_NOME.
#CNPJ_DB_TIPO=mysql
#CNPJ_DB_HOST=localhost
#CNPJ_DB_PORTA=3306
#CNPJ_DB_NOME=dados_rfb
#CNPJ_DB_USUARIO=root
#CNPJ_DB_SENHA=troque_esta_senha

# --- SQL Server (planejado) --------------------------------------------------
#CNPJ_DB_TIPO=sqlserver
#CNPJ_DB_HOST=localhost
#CNPJ_DB_PORTA=1433
#CNPJ_DB_NOME=dados_rfb
#CNPJ_DB_USUARIO=sa
#CNPJ_DB_SENHA=troque_esta_senha
#CNPJ_DB_SCHEMA=dbo

# --- Oracle (planejado) ------------------------------------------------------
# Em CNPJ_DB_NOME vai o service name (ex.: XEPDB1, FREEPDB1, ORCLPDB1).
# No Oracle o schema e o usuario dono das tabelas.
#CNPJ_DB_TIPO=oracle
#CNPJ_DB_HOST=localhost
#CNPJ_DB_PORTA=1521
#CNPJ_DB_NOME=FREEPDB1
#CNPJ_DB_USUARIO=dados_rfb
#CNPJ_DB_SENHA=troque_esta_senha
#CNPJ_DB_SCHEMA=DADOS_RFB

# =============================================================================
# DOWNLOAD DOS ARQUIVOS DA RECEITA (cnpj_full/download.py, docs/download.md)
# =============================================================================
# URL do compartilhamento da RF
CNPJ_RF_URL=https://arquivos.receitafederal.gov.br/index.php/s/YggdBLfdninEJX9
# Pasta onde salvar os ZIPs (vao para <pasta>/<AAAA-MM>/)
CNPJ_PASTA_DOWNLOAD=dados

# =============================================================================
# OUTROS
# =============================================================================
# --- Consultas ---------------------------------------------------------------
# Navegador aberto automaticamente com o grafo.html (--viz). Vazio: nao abre.
#CNPJ_NAVEGADOR=C:/Program Files/Google/Chrome/Application/chrome.exe

# --- Docker (docker-compose.yml) --------------------------------------------
# No Linux, use o seu usuario para os arquivos gerados no volume nao ficarem do root.
# Valores: saida de "id -u" e "id -g". No Windows (Docker Desktop) deixe comentado.
#CNPJ_UID=1000
#CNPJ_GID=1000

# --- Scripts extra_csv (separar estabelecimento.csv por UF ou municipio) -----
# Pasta do estabelecimento.csv gerado pela carga csv (python cnpj_full/carga.py ... csv saida --dir)
#FILES_LOCATION=saida
